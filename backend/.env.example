# Database (SQLite for local dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./ticketforge.db

# GitHub OAuth (create an OAuth app at https://github.com/settings/developers)
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_WEBHOOK_SECRET=xxx

# Claude API
ANTHROPIC_API_KEY=xxx

# Stripe (optional — billing features won't work without these)
STRIPE_SECRET_KEY=xxx
STRIPE_WEBHOOK_SECRET=xxx
STRIPE_PRICE_ID_TEAM=xxx

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=change-me-in-production

# Local dev bootstrap identity used by /api/auth/dev-login
LOCAL_DEV_GITHUB_ID=0
LOCAL_DEV_GITHUB_LOGIN=shekerkamma
LOCAL_DEV_EMAIL=shekerkamma@users.noreply.github.com
LOCAL_DEV_TEAM_NAME=Shekerk Dev Team

# Redis (optional — needed for ARQ task queue)
REDIS_URL=redis://localhost:6379

# Encryption (for GitHub token encryption at rest)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
