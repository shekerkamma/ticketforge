# Database (SQLite for local dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./ticketforge.db

# GitHub OAuth (create an OAuth app at https://github.com/settings/developers)
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_WEBHOOK_SECRET=xxx

# Claude API
ANTHROPIC_API_KEY=xxx

# Stripe (optional — billing features won't work without these)
STRIPE_SECRET_KEY=xxx
STRIPE_WEBHOOK_SECRET=xxx
STRIPE_PRICE_ID_TEAM=xxx

# App URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
JWT_SECRET=change-me-in-production

# Redis (optional — needed for ARQ task queue)
REDIS_URL=redis://localhost:6379

# Encryption (for GitHub token encryption at rest — must be 32+ chars)
ENCRYPTION_KEY=
