# Production environment for docker-compose.prod.yml

# Postgres
POSTGRES_USER=ticketforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticketforge

# Public app URLs
APP_URL=https://ticketforge.example.com
API_URL=https://api.ticketforge.example.com

# Backend secrets
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-fernet-key

# GitHub OAuth
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

# Anthropic
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_PRICE_ID_TEAM=replace-with-stripe-price-id

# Monitoring
SENTRY_DSN=

# Optional local-dev-only values. Not needed in production unless you still want /api/auth/dev-login.
LOCAL_DEV_GITHUB_ID=0
LOCAL_DEV_GITHUB_LOGIN=shekerkamma
LOCAL_DEV_EMAIL=shekerkamma@users.noreply.github.com
LOCAL_DEV_TEAM_NAME=Shekerk Dev Team
