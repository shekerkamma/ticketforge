{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strategy Brief",
  "type": "object",
  "required": [
    "report_slug",
    "created_at",
    "decision",
    "why_this_matters",
    "executive_view",
    "strategic_implications",
    "recommended_actions",
    "kpis",
    "bottom_line"
  ],
  "properties": {
    "report_slug": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision": {
      "type": "string"
    },
    "why_this_matters": {
      "type": "string"
    },
    "executive_view": {
      "type": "string"
    },
    "strategic_implications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "recommended_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "why",
          "priority"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "kpis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "bottom_line": {
      "type": "string"
    }
  }
}
