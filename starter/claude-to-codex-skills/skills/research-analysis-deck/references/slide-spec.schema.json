{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slide Spec",
  "type": "object",
  "required": [
    "slide_id",
    "section",
    "slide_type",
    "title",
    "objective",
    "audience",
    "layout",
    "content_blocks",
    "source_ids"
  ],
  "properties": {
    "slide_id": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "slide_type": {
      "type": "string",
      "enum": [
        "hero",
        "agenda",
        "section-divider",
        "summary-cards",
        "kpi-grid",
        "bar-chart",
        "distribution-chart",
        "comparison",
        "use-case-table",
        "cluster-spotlight",
        "snapshot-grid",
        "case-study",
        "recommendation",
        "roadmap",
        "methodology",
        "source-coverage",
        "custom"
      ]
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "content_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "label",
          "body"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "headline",
              "bullet-list",
              "metric",
              "callout",
              "chart-brief",
              "table",
              "comparison-column",
              "company-card",
              "quote",
              "roadmap-step",
              "note"
            ]
          },
          "label": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "speaker_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
