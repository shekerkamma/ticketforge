{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis Pack",
  "type": "object",
  "required": [
    "report_slug",
    "created_at",
    "decision_question",
    "audience",
    "headline",
    "source_ids",
    "findings",
    "use_case_clusters",
    "risks",
    "recommendations",
    "chart_briefs",
    "methodology"
  ],
  "properties": {
    "report_slug": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_question": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "title",
          "statement",
          "implication",
          "confidence",
          "source_ids"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "implication": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "metric": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "use_case_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "name",
          "buyer",
          "workflow_owner",
          "business_job",
          "value_prop",
          "why_now",
          "recommendation",
          "evidence_companies"
        ],
        "properties": {
          "cluster_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "buyer": {
            "type": "string"
          },
          "workflow_owner": {
            "type": "string"
          },
          "business_job": {
            "type": "string"
          },
          "value_prop": {
            "type": "string"
          },
          "why_now": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "evidence_companies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "proof_line",
                "source_id"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "proof_line": {
                  "type": "string"
                },
                "source_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "why",
          "priority"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "chart_briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "best_chart_type",
          "why_this_fits",
          "narrative_takeaway",
          "encoding_guidance",
          "annotation_plan"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "best_chart_type": {
            "type": "string"
          },
          "why_this_fits": {
            "type": "string"
          },
          "narrative_takeaway": {
            "type": "string"
          },
          "encoding_guidance": {
            "type": "string"
          },
          "annotation_plan": {
            "type": "string"
          }
        }
      }
    },
    "methodology": {
      "type": "object",
      "required": [
        "approach",
        "limitations"
      ],
      "properties": {
        "approach": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
