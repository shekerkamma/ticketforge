{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck Plan",
  "type": "object",
  "required": [
    "report_slug",
    "created_at",
    "audience",
    "deck_goal",
    "theme_reference",
    "story_arc",
    "slides",
    "export_targets"
  ],
  "properties": {
    "report_slug": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "audience": {
      "type": "string"
    },
    "deck_goal": {
      "type": "string"
    },
    "theme_reference": {
      "type": "string"
    },
    "story_arc": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slide_id",
          "section",
          "slide_type",
          "title",
          "objective",
          "audience",
          "layout",
          "content_blocks",
          "source_ids"
        ],
        "properties": {
          "slide_id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "slide_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "audience": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "content_blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "kind",
                "label",
                "body"
              ],
              "properties": {
                "kind": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          },
          "speaker_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "export_targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pptx",
          "html",
          "pdf",
          "marp",
          "memo"
        ]
      }
    }
  }
}
